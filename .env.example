# Enable local model selection with the native Ollama API on 127.0.0.1:11434.
# Leave both model variables empty to omit Ollama. Deterministic Rules uses no LLM.
WORKBENCH_OLLAMA_MODEL=qwen3:4b
WORKBENCH_OLLAMA_MODELS=llama3.2:3b,granite3.3:2b,mistral:7b-instruct-v0.3-q4_K_M
WORKBENCH_OLLAMA_TIMEOUT_SECONDS=120

# Optional external provider. Local Ollama mode uses no API key.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODELS=
OPENAI_TIMEOUT_SECONDS=20
# Applies to the external OpenAI provider.
ALLOW_RECORDED_MODEL=false

# Optional absolute or repository-relative path to the normalized catalog JSON.
# The default is data/imported/catalog.json. Restart FastAPI after importing.
# Optional labeled evaluation_cases.json goes beside the selected catalog.
WORKBENCH_CATALOG_PATH=

# python or matlab_offline. The latter uses MATLAB Engine when available.
CONTROLLER_BACKEND=python

# Separate backend for synthetic controller tuning: matlab_offline or python.
WORKBENCH_TUNING_BACKEND=matlab_offline

# Optional repository-relative path to a private, versioned research config.
RESEARCH_THRESHOLDS=
WORKBENCH_AUDIT_FILE=
